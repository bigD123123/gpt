<Application x:Class="TrainerStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#111820" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1B2633" />
    <SolidColorBrush x:Key="Accent" Color="#50B7C7" />
    <SolidColorBrush x:Key="Muted" Color="#AFC0CE" />
    <SolidColorBrush x:Key="Danger" Color="#CF525C" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E7F0F7" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="#EFF8FF" />
      <Setter Property="Background" Value="#2A4A62" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="#E7F0F7" />
      <Setter Property="Background" Value="#0D141C" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Foreground" Value="#E7F0F7" />
      <Setter Property="Background" Value="#0D141C" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Foreground" Value="#E7F0F7" />
      <Setter Property="Background" Value="#0D141C" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <ContentPresenter Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#2A4A62" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemBorder" Property="Background" Value="#50B7C7" />
                <Setter Property="Foreground" Value="#111820" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#768895" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
