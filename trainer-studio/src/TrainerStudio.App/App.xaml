<Application x:Class="TrainerStudio.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBackground" Color="#111820" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1B2633" />
    <SolidColorBrush x:Key="Accent" Color="#50B7C7" />
    <SolidColorBrush x:Key="Muted" Color="#AFC0CE" />
    <SolidColorBrush x:Key="Danger" Color="#CF525C" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E7F0F7" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Foreground" Value="#EFF8FF" />
      <Setter Property="Background" Value="#2A4A62" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Foreground" Value="#E7F0F7" />
      <Setter Property="Background" Value="#0D141C" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Margin" Value="4" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Foreground" Value="#E7F0F7" />
      <Setter Property="Background" Value="#0D141C" />
      <Setter Property="BorderBrush" Value="#50758D" />
    </Style>
  </Application.Resources>
</Application>
