<Window x:Class="TrainerStudio.App.TrainerPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Min Trainer" Height="680" Width="500" MinHeight="420" MinWidth="360"
        Background="{StaticResource PageBackground}" Foreground="#E7F0F7"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="MIN TRAINER" FontSize="25" FontWeight="Bold" />
    <TextBlock Grid.Row="1" Text="Dine gemte funktioner. Hver ændring skal stadig godkendes." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14" />

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="CategoriesPanel" />
    </ScrollViewer>

    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
      <Button Content="STOP ALLE (Esc)" Background="{StaticResource Danger}" Click="StopAll_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
