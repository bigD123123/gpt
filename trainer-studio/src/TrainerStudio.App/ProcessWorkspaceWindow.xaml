<Window x:Class="TrainerStudio.App.ProcessWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trainer Studio v0.3.0" Width="1460" Height="960" MinWidth="1080" MinHeight="720"
        Background="{StaticResource PageBackground}" Foreground="#E7F0F7"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel>
      <TextBlock Text="TRAINER STUDIO · 0.3.0" FontSize="27" FontWeight="Bold" />
      <TextBlock Text="Windows-processer · find værdi → opret funktion → gem profil" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="18,0,0,0" />
    </DockPanel>
    <Border Grid.Row="1" Background="{StaticResource PanelBackground}" BorderBrush="#365269" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,12">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="1. Vælg dit lokale spil eller program" FontWeight="SemiBold" />
            <ComboBox x:Name="ProcessesBox" ItemsSource="{Binding Processes}" DisplayMemberPath="Display" MinWidth="260" />
          </StackPanel>
          <WrapPanel Grid.Column="1" VerticalAlignment="Bottom">
            <Button x:Name="RefreshProcessesButton" Content="Opdater processer" Click="RefreshProcesses_Click" />
            <Button x:Name="AttachButton" Content="Forbind (kun læsning)" Click="Attach_Click" />
            <Button x:Name="DetachButton" Content="Afbryd" Click="Detach_Click" IsEnabled="False" />
            <Button Content="STOP ALLE (Esc)" Background="{StaticResource Danger}" Click="StopAll_Click" />
          </WrapPanel>
        </Grid>
        <WrapPanel Margin="4,4,0,0">
          <CheckBox x:Name="WritesCheckBox" Content="Tillad værdiændringer i det valgte program" IsEnabled="False"
                    Checked="Writes_Checked" Unchecked="Writes_Unchecked" Margin="0,0,18,0" />
          <CheckBox Content="Hold øverst" Checked="Topmost_Checked" Unchecked="Topmost_Unchecked" />
        </WrapPanel>
        <TextBlock x:Name="TargetInfoText" Text="Ingen proces tilknyttet. Listen opdateres automatisk; appen forbinder ikke uden dit valg." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,6,0,0" />
        <TextBlock x:Name="RecognitionText" Foreground="#BFE6C5" TextWrapping="Wrap" Margin="4,4,0,0" />
      </StackPanel>
    </Border>
    <TabControl Grid.Row="2" Background="{StaticResource PageBackground}" BorderBrush="#365269" Foreground="#E7F0F7">
      <TabItem Header="2. Søg og opret funktion">
        <Grid Background="{StaticResource PageBackground}" Margin="10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="ScanOptionsPanel">
              <UniformGrid Columns="4">
                <StackPanel><TextBlock Text="Datatype" /><ComboBox x:Name="DataTypeBox" SelectedIndex="4">
                  <ComboBoxItem Content="Int8" /><ComboBoxItem Content="UInt8" /><ComboBoxItem Content="Int16" /><ComboBoxItem Content="UInt16" />
                  <ComboBoxItem Content="Int32" /><ComboBoxItem Content="UInt32" /><ComboBoxItem Content="Int64" /><ComboBoxItem Content="UInt64" />
                  <ComboBoxItem Content="Float" /><ComboBoxItem Content="Double" /><ComboBoxItem Content="Boolean" />
                </ComboBox></StackPanel>
                <StackPanel><TextBlock Text="Sammenligning" /><ComboBox x:Name="ConditionBox" SelectedIndex="0" SelectionChanged="Condition_Changed">
                  <ComboBoxItem Content="Præcis værdi" /><ComboBoxItem Content="Ukendt startværdi" /><ComboBoxItem Content="Steget" />
                  <ComboBoxItem Content="Faldet" /><ComboBoxItem Content="Ændret" /><ComboBoxItem Content="Uændret" />
                </ComboBox></StackPanel>
                <StackPanel><TextBlock Text="Værdi" /><TextBox x:Name="SearchValueBox" Text="100" /></StackPanel>
                <StackPanel><TextBlock Text="Maks. læsning (MiB)" /><TextBox x:Name="MaxMemoryBox" Text="256" /></StackPanel>
              </UniformGrid>
              <WrapPanel Margin="4,4,0,2">
                <CheckBox x:Name="WritableOnlyCheckBox" Content="Kun skrivbare dataområder" IsChecked="True" Margin="0,0,16,0" />
                <CheckBox x:Name="EveryByteCheckBox" Content="Ujusterede værdier (langsommere)" />
                <CheckBox x:Name="MappedCheckBox" Content="Medtag mapped områder" Margin="16,0,0,0" />
              </WrapPanel>
              <UniformGrid Columns="2">
                <StackPanel><TextBlock Text="Startadresse, hex (tom = fra start)" Foreground="{StaticResource Muted}" /><TextBox x:Name="StartAddressBox" /></StackPanel>
                <StackPanel><TextBlock Text="Slutadresse, hex (tom = til slut)" Foreground="{StaticResource Muted}" /><TextBox x:Name="EndAddressBox" /></StackPanel>
              </UniformGrid>
              <TextBlock x:Name="ScanHintText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,4,4,6" />
            </StackPanel>
            <DataGrid Grid.Row="1" x:Name="ResultsGrid" ItemsSource="{Binding Hits}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="Result_Changed"
                      EnableRowVirtualization="True" Margin="4" BorderBrush="#365269">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Adresse" Binding="{Binding AddressText}" Width="1.1*" />
                <DataGridTextColumn Header="Værdi" Binding="{Binding Current}" Width="*" />
                <DataGridTextColumn Header="Ændring" Binding="{Binding Change}" Width="1.3*" />
                <DataGridTextColumn Header="Område" Binding="{Binding Region}" Width="1.4*" />
              </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2">
              <WrapPanel>
                <Button x:Name="FirstScanButton" Content="Første søgning" Click="FirstScan_Click" IsEnabled="False" />
                <Button x:Name="NextScanButton" Content="Næste søgning" Click="NextScan_Click" IsEnabled="False" />
                <Button x:Name="ReadSelectedButton" Content="Læs valgt igen" Click="ReadSelected_Click" IsEnabled="False" />
                <Button x:Name="ClearScanButton" Content="Ryd søgning" Click="ClearScan_Click" />
                <Button x:Name="CancelButton" Content="Annullér søgning" Click="CancelScan_Click" IsEnabled="False" />
              </WrapPanel>
              <ProgressBar x:Name="ScanProgressBar" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="4" />
              <TextBlock x:Name="ScanStatusText" Text="Ingen aktiv søgning. Resultaterne viser kun de undersøgte hukommelsesområder." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="4" />
            </StackPanel>
          </Grid>
          <Border Grid.Column="1" Background="{StaticResource PanelBackground}" CornerRadius="5" Padding="12" Margin="10,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="BuilderPanel">
                <TextBlock Text="3. Opret en trainerfunktion" FontWeight="SemiBold" FontSize="17" />
                <TextBlock x:Name="ReferenceText" Text="Vælg et søgeresultat. Heap-adresser gemmes kun til denne session, indtil du har en valideret pointersti." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5,0,8" />
                <TextBlock Text="Navn" /><TextBox x:Name="FeatureNameBox" Text="Min funktion" />
                <UniformGrid Columns="2">
                  <StackPanel><TextBlock Text="Kontrol" /><ComboBox x:Name="ControlBox" SelectedIndex="0" SelectionChanged="BuilderRules_Changed">
                    <ComboBoxItem Content="Knap" /><ComboBoxItem Content="Kontakt" /><ComboBoxItem Content="Slider" /><ComboBoxItem Content="Talindtastning" />
                  </ComboBox></StackPanel>
                  <StackPanel><TextBlock Text="Handling" /><ComboBox x:Name="OperationBox" SelectedIndex="0" SelectionChanged="BuilderRules_Changed">
                    <ComboBoxItem Content="Indstil værdi" /><ComboBoxItem Content="Tilføj værdi" /><ComboBoxItem Content="Fasthold værdi" /><ComboBoxItem Content="Gendan oprindelig" />
                  </ComboBox></StackPanel>
                </UniformGrid>
                <TextBlock Text="Værdi (negativt tal trækker fra ved Tilføj)" /><TextBox x:Name="FeatureValueBox" Text="999" />
                <UniformGrid x:Name="SliderOptionsPanel" Columns="3" Visibility="Collapsed">
                  <StackPanel><TextBlock Text="Minimum" /><TextBox x:Name="SliderMinimumBox" Text="0" /></StackPanel>
                  <StackPanel><TextBlock Text="Maksimum" /><TextBox x:Name="SliderMaximumBox" Text="1000" /></StackPanel>
                  <StackPanel><TextBlock Text="Trin" /><TextBox x:Name="SliderStepBox" Text="1" /></StackPanel>
                </UniformGrid>
                <TextBlock Text="Kategori" /><TextBox x:Name="CategoryBox" Text="Min trainer" />
                <TextBlock Text="Beskrivelse" /><TextBox x:Name="DescriptionBox" AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
                <TextBlock Text="Genvej i appen (fx F1 eller Ctrl+F2)" /><TextBox x:Name="HotkeyBox" />
                <Button Content="Opret fra valgt værdi / pointersti" Click="CreateFeature_Click" />
                <Button Content="Opdatér valgt trainerfunktion" Click="UpdateFeature_Click" />
                <TextBlock Text="En livs-, penge- eller hastighedsfunktion virker kun, hvis den valgte værdi faktisk styrer det ønskede i spillet." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="4,8,4,0" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Pointerstier">
        <Grid Background="{StaticResource PageBackground}" Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Find modulbaserede pointerstier til en valgt værdi" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="Vælg først et søgeresultat. Søgningen er afgrænset af samme hukommelsesbudget som værdisøgningen. En sti skal genvalideres efter genstart; et fund er ikke et løfte om stabilitet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8" />
            <WrapPanel x:Name="PointerOptionsPanel">
              <StackPanel><TextBlock Text="Dybde (1–5)" /><TextBox x:Name="PointerDepthBox" Text="3" Width="100" /></StackPanel>
              <StackPanel><TextBlock Text="Maks. offset (bytes)" /><TextBox x:Name="PointerOffsetBox" Text="4096" Width="150" /></StackPanel>
              <Button x:Name="PointerScanButton" Content="Find stier til valgt værdi" Click="PointerScan_Click" VerticalAlignment="Bottom" IsEnabled="False" />
              <Button Content="Hent stier fra profilen" Click="LoadProfilePointers_Click" VerticalAlignment="Bottom" />
              <Button x:Name="PointerRescanButton" Content="Genvalidér fundne stier" Click="PointerRescan_Click" VerticalAlignment="Bottom" IsEnabled="False" />
              <Button x:Name="UsePointerButton" Content="Brug valgt sti i Builder" Click="UsePointer_Click" VerticalAlignment="Bottom" IsEnabled="False" />
            </WrapPanel>
          </StackPanel>
          <DataGrid Grid.Row="1" x:Name="PointersGrid" ItemsSource="{Binding PointerRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Margin="4,10">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Rodmodul" Binding="{Binding Module}" Width="*" />
              <DataGridTextColumn Header="Rodoffset" Binding="{Binding Offset}" Width="*" />
              <DataGridTextColumn Header="Pointer-offsets" Binding="{Binding Path}" Width="2*" />
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.5*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" x:Name="PointerStatusText" Text="Ingen pointeranalyse endnu." TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
        </Grid>
      </TabItem>
      <TabItem Header="Min trainer og profiler">
        <Grid Background="{StaticResource PageBackground}" Margin="14">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <WrapPanel>
              <Button Content="Åbn min trainer" Click="OpenTrainer_Click" /><Button Content="Brug valgt" Click="UseFeature_Click" />
              <Button Content="Deaktivér valgt" Click="DeactivateFeature_Click" /><Button Content="Redigér valgt" Click="EditFeature_Click" />
              <Button Content="Kopiér" Click="CopyFeature_Click" /><Button Content="Flyt op" Click="MoveUp_Click" />
              <Button Content="Flyt ned" Click="MoveDown_Click" /><Button Content="Slet" Click="DeleteFeature_Click" Background="{StaticResource Danger}" />
            </WrapPanel>
            <DataGrid Grid.Row="1" x:Name="FeaturesGrid" ItemsSource="{Binding FeatureRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionUnit="FullRow" Margin="4,10">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Navn" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Kontrol" Binding="{Binding Control}" Width="*" />
                <DataGridTextColumn Header="Reference / status" Binding="{Binding Status}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="2" x:Name="TrainerStatusText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4" />
          </Grid>
          <Border Grid.Column="1" Background="{StaticResource PanelBackground}" Padding="12" Margin="10,0,0,0" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Profilbibliotek" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Navn" /><TextBox x:Name="ProfileNameBox" Text="Min spilprofil" />
                <TextBlock Text="Noter" /><TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="65" />
                <WrapPanel><Button Content="Gem profil" Click="SaveProfile_Click" /><Button Content="Ny profil til proces" Click="NewProfile_Click" /></WrapPanel>
                <TextBlock Text="Gemte profiler" Margin="0,12,0,0" />
                <ComboBox x:Name="ProfilesBox" ItemsSource="{Binding Profiles}" DisplayMemberPath="Display" />
                <WrapPanel>
                  <Button Content="Indlæs" Click="LoadProfile_Click" /><Button Content="Valider" Click="ValidateProfile_Click" />
                  <Button Content="Duplikér" Click="DuplicateProfile_Click" /><Button Content="Eksportér" Click="ExportProfile_Click" />
                  <Button Content="Importér" Click="ImportProfile_Click" />
                </WrapPanel>
                <TextBlock Text="Sessionadresser markeres ugyldige efter genstart. Modul- og pointerreferencer kontrolleres mod programidentitet og build før brug. Ingen funktioner aktiveres automatisk." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,10" />
                <TextBlock Text="Status for denne udgave" FontWeight="SemiBold" />
                <TextBlock Text="Windows-API'er og kerneregler testes automatisk. Kompatibilitet med dine Unity-, Unreal- og ældre spil afventer rigtige spiltests. Engine-navne i proceslisten er kun filbaserede hints." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,5" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Hændelser">
        <Grid Background="{StaticResource PageBackground}" Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBlock Text="Synlige handlinger, resultater og fejl. Loggen gemmes også lokalt i TrainerStudio\events.jsonl." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="4,0,0,8" />
          <TextBox Grid.Row="1" x:Name="EventsBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="3" Background="#0D141C" BorderBrush="#365269" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="Klar. Vælg et lokalt program, som du ejer eller har tilladelse til at undersøge." Foreground="#BFE6C5" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
