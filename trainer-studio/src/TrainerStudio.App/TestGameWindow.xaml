<Window x:Class="TrainerStudio.App.TestGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trainer Studio – eget testspil" Height="430" Width="560" ResizeMode="CanMinimize"
        Background="{StaticResource PageBackground}" Foreground="#E7F0F7" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="OWNED TEST GAME" FontSize="25" FontWeight="Bold" />
    <TextBlock Grid.Row="1" Text="Dokumenterede Int32-værdier og testhandlinger. Dette vindue er del af det ejede testmål." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,18" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="AKTUEL TILSTAND" FontWeight="SemiBold" />
        <TextBlock x:Name="StateText" FontFamily="Consolas" FontSize="17" Margin="0,10,0,8" />
        <TextBlock Text="Handlingerne skaber bevidst også distraktørværdier, så søgningen skal indsnævres korrekt." Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
      </StackPanel>
      <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Top">
        <Button Content="Saml +25" Click="Collect_Click" />
        <Button Content="Køb −10" Click="Spend_Click" />
        <Button Content="Tag skade −15" Click="Damage_Click" />
        <Button Content="Helbred +10" Click="Heal_Click" />
        <Button Content="Affyr −1" Click="Fire_Click" />
        <Button Content="Genlad +5" Click="Reload_Click" />
        <Button Content="Dræn stamina" Click="DrainStamina_Click" />
        <Button Content="Timer −1" Click="TickTimer_Click" />
      </UniformGrid>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,18,0,0">
      <Button Content="Nulstil testspil" Click="Reset_Click" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="8,0,0,0" />
    </StackPanel>
  </Grid>
</Window>
