<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="TrainerScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="#365269" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}"
                  CornerRadius="3" Margin="2" SnapsToDevicePixels="True" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#50758D" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#50B7C7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ThumbBorder" Property="Background" Value="#263A4B" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrainerScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Delay" Value="250" />
    <Setter Property="Interval" Value="60" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TrainerScrollBarArrowButton" TargetType="RepeatButton"
         BasedOn="{StaticResource TrainerScrollBarPageButton}">
    <Setter Property="Background" Value="#0D141C" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="ArrowBorder" Background="{TemplateBinding Background}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="ArrowContent" HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ArrowBorder" Property="Background" Value="#365269" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ArrowBorder" Property="Background" Value="#50758D" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ArrowContent" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="TrainerVerticalScrollBar" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
        <RowDefinition Height="16" />
      </Grid.RowDefinitions>
      <RepeatButton Grid.Row="0" Style="{StaticResource TrainerScrollBarArrowButton}"
                    Command="{x:Static ScrollBar.LineUpCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <Path Data="M 0,4 L 4,0 L 8,4 Z" Fill="#AFC0CE" />
      </RepeatButton>
      <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical"
             IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource TrainerScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageUpCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource TrainerScrollBarThumb}" MinHeight="16" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource TrainerScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageDownCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Row="2" Style="{StaticResource TrainerScrollBarArrowButton}"
                    Command="{x:Static ScrollBar.LineDownCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <Path Data="M 0,0 L 4,4 L 8,0 Z" Fill="#AFC0CE" />
      </RepeatButton>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="TrainerHorizontalScrollBar" TargetType="ScrollBar">
    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
      </Grid.ColumnDefinitions>
      <RepeatButton Grid.Column="0" Style="{StaticResource TrainerScrollBarArrowButton}"
                    Command="{x:Static ScrollBar.LineLeftCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <Path Data="M 4,0 L 0,4 L 4,8 Z" Fill="#AFC0CE" />
      </RepeatButton>
      <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal"
             IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource TrainerScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageLeftCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource TrainerScrollBarThumb}" MinWidth="16" />
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource TrainerScrollBarPageButton}"
                        Command="{x:Static ScrollBar.PageRightCommand}"
                        CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
        </Track.IncreaseRepeatButton>
      </Track>
      <RepeatButton Grid.Column="2" Style="{StaticResource TrainerScrollBarArrowButton}"
                    Command="{x:Static ScrollBar.LineRightCommand}"
                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
        <Path Data="M 0,0 L 4,4 L 0,8 Z" Fill="#AFC0CE" />
      </RepeatButton>
    </Grid>
  </ControlTemplate>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="#0D141C" />
    <Setter Property="Foreground" Value="#AFC0CE" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="Auto" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Template" Value="{StaticResource TrainerVerticalScrollBar}" />
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Template" Value="{StaticResource TrainerHorizontalScrollBar}" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
